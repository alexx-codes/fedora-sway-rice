# Pastel Cat — light mode palette (daytime / bright rooms).
# Hand-defined, deliberately NOT matugen-derived: a light scheme pulled from
# a dark wallpaper comes out muddy. Chrome (bars, widgets, backgrounds) uses
# soft anime-pastel pinks/lavenders; text-bearing colors (terminal ANSI,
# accents used for text) are darkened, Catppuccin-Latte-informed values so
# contrast stays solid — aesthetics never override readability.
# All files next to this one are GENERATED by scripts/theme-gen.py.
MODE=light
NAME="Pastel Cat"
WALLPAPER=day
GTK_THEME=adw-gtk3
ICON_THEME=Papirus-Light
COLOR_SCHEME=prefer-light

