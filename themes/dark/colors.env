# Tokyo Night — dark mode palette (daily driver).
# Single source of truth for dark mode. All files next to this one are
# GENERATED from it by scripts/theme-gen.py — edit here, then regenerate.
# This file is also the output target of matugen (scripts/theme-regen.sh),
# which re-derives it from the night wallpaper; these committed values are
# hand-tuned canonical Tokyo Night and work without matugen installed.
MODE=dark
NAME="Tokyo Night"
WALLPAPER=night
GTK_THEME=adw-gtk3-dark
ICON_THEME=Papirus-Dark
COLOR_SCHEME=prefer-dark

