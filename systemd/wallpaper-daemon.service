# Wallpaper daemon: swww when available (animated theme transitions),
# swaybg fallback otherwise. See scripts/wallpaper-daemon.sh.
[Unit]
Description=Wallpaper daemon (swww with swaybg fallback)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.config/rice/scripts/wallpaper-daemon.sh
Restart=on-failure
RestartSec=1

[Install]
WantedBy=sway-session.target
