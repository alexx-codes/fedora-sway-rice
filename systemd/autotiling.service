# autotiling — alternates sway's split direction to suit each window's shape.
# ConditionPathIsExecutable rather than a bare ExecStart: pipx installs outside
# any package manager, so a missing binary must skip the unit cleanly instead
# of restart-looping. Sway tiles normally without it, so there is nothing to
# fall back to and nothing that breaks.
[Unit]
Description=autotiling for sway
Documentation=https://github.com/nwg-piotr/autotiling
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathIsExecutable=%h/.local/bin/autotiling

[Service]
Type=simple
ExecStart=%h/.local/bin/autotiling
Restart=on-failure
RestartSec=1

[Install]
WantedBy=sway-session.target
