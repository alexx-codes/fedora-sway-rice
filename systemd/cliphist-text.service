# Clipboard history: capture text selections into cliphist's database.
[Unit]
Description=cliphist text watcher
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/wl-paste --type text --watch cliphist store
Restart=on-failure
RestartSec=2

[Install]
WantedBy=sway-session.target
