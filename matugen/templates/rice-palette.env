# GENERATED by matugen from the current wallpaper — do not edit.
#
# Deliberately only the SURFACE, TEXT and ACCENT roles. The semantic colors
# (RED/ORANGE/GREEN/YELLOW/…) and the whole ANSI block stay in
# theme/colors.env and are NOT derived from the wallpaper:
#
#   - semantic colors carry meaning. A "battery critical" badge that turns
#     wallpaper-brown is no longer a warning, it is decoration.
#   - ANSI colors drive syntax highlighting in kitty. Re-hueing them per
#     wallpaper makes every language look wrong.
#
# scripts/theme-gen.py --from-wallpaper overlays these onto colors.env, runs
# the same contrast gate as the static path, and regenerates every app.
BG={{colors.surface.default.hex_stripped}}
BG_ALT={{colors.surface_container.default.hex_stripped}}
BG_HL={{colors.surface_container_high.default.hex_stripped}}
BG_SEL={{colors.surface_container_highest.default.hex_stripped}}
BORDER={{colors.outline_variant.default.hex_stripped}}
FG={{colors.on_surface.default.hex_stripped}}
FG_DIM={{colors.on_surface_variant.default.hex_stripped}}
MUTED={{colors.outline.default.hex_stripped}}
ACCENT={{colors.primary.default.hex_stripped}}
ACCENT2={{colors.tertiary.default.hex_stripped}}
