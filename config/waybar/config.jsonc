// Waybar — fedora-sway-rice
// System load (CPU / RAM / temp / net) sits right of center, always visible:
// this machine runs KVM guests and load must be readable at a glance.
// The custom/vms module shows running libvirt domains (hidden when libvirt
// isn't reachable). Colors come from ~/.config/waybar/theme.css, a symlink
// into the active theme — reloaded by SIGUSR2 from theme-toggle.sh.
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,

    "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
    "modules-center": ["clock"],
    "modules-right": [
        "custom/vms",
        "cpu",
        "memory",
        "disk",
        "temperature",
        "network",
        "pulseaudio",
        "backlight",
        "battery",
        "tray",
        "custom/osk",
        "custom/notification",
        "custom/power"
    ],

    "sway/workspaces": {
        "disable-scroll": false,
        "format": "{icon}",
        "format-icons": {
            "1": "1 ",
            "2": "2 󰨞",
            "3": "3 󰈹",
            "4": "4 󰢹",
            "10": "10 󰭹"
        }
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "sway/window": {
        "max-length": 60,
        "icon": false
    },

    "clock": {
        "format": "{:%a %b %d  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<b><u>{}</u></b>"
            }
        }
    },

    "custom/vms": {
        // Running libvirt domain count; tooltip lists the domains.
        // exec-if hides the module entirely if virsh is missing or the
        // user can't reach qemu:///system (e.g. not in the libvirt group).
        "exec": "~/.config/rice/scripts/libvirt-status.sh",
        "exec-if": "command -v virsh",
        "return-type": "json",
        "interval": 15,
        "format": "󰢹 {}",
        "on-click": "~/.config/rice/scripts/launch-or-focus.sh 4 '^(virt-manager|.*[Vv]irt-manager.*)$' virt-manager"
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "states": { "warning": 70, "critical": 90 },
        "on-click": "foot -e btop"
    },

    "memory": {
        "format": "󰍛 {used:0.1f}G",
        "tooltip-format": "{used:0.1f}G used / {total:0.1f}G ({percentage}%)\nswap: {swapUsed:0.1f}G",
        "interval": 5,
        "states": { "warning": 70, "critical": 90 },
        "on-click": "foot -e btop"
    },

    "disk": {
        // On a 512 GB single-volume machine running qcow2 VM images, root
        // filesystem headroom is the gauge that matters most — images grow
        // silently until the filesystem is full.
        "path": "/",
        "format": "󰋊 {free}",
        "tooltip-format": "{used} used / {total} ({percentage_used}% full)\nfree: {free}",
        "states": { "warning": 80, "critical": 92 },
        "interval": 60
    },

    "temperature": {
        // __THERMAL_ZONE__ is resolved at deploy time by install.sh: it scans
        // /sys/class/thermal for the CPU package sensor (x86_pkg_temp/TCPU)
        // instead of trusting zone 0, which on ThinkPads is often acpitz
        // (chassis) and reads plausible-but-wrong. verify.sh reports the pick.
        "thermal-zone": __THERMAL_ZONE__,
        "critical-threshold": 85,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""],
        "interval": 5
    },

    "network": {
        "format-wifi": "{icon} {bandwidthDownBytes} 󰕒{bandwidthUpBytes}",
        "format-ethernet": "󰈀 {bandwidthDownBytes} 󰕒{bandwidthUpBytes}",
        "format-disconnected": "󰤮 offline",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr} via {gwaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr} via {gwaddr}",
        "interval": 2,
        "on-click": "foot -e nmtui"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 mute",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "pavucontrol",
        "on-click-right": "~/.config/rice/scripts/volume.sh mute"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"]
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "states": { "warning": 25, "critical": 10 },
        "interval": 30
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/notification": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "escape": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󱅫",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "on-click": "swaync-client -t -sw",
        "tooltip": false
    },

    "custom/osk": {
        // Tap target for the on-screen keyboard — the one control that must
        // be reachable by touch alone (a keybind can't summon a keyboard
        // when there's no keyboard).
        "format": "󰌌",
        "tooltip": false,
        "on-click": "~/.config/rice/scripts/osk.sh"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.config/rice/scripts/powermenu.sh"
    }
}
