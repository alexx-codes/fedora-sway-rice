#!/usr/bin/env python3
"""Launcher for the rice Settings app.

Kept deliberately thin, and it fails with an explanation rather than a Python
traceback when PyGObject is missing — a settings app that can't start should
say why and how to fix it.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

try:
    from rice_settings.app import main
except ImportError as e:
    missing = str(e)
    msg = (
        "The Settings app needs GTK4 and libadwaita Python bindings.\n\n"
        f"  {missing}\n\n"
        "Install them with:\n"
        "  sudo dnf install python3-gobject gtk4 libadwaita\n"
        "or run:  ./verify.sh --fix\n"
    )
    print(msg, file=sys.stderr)
    # Surface it on screen too — this is usually launched from a keybind,
    # where stderr goes nowhere at all.
    try:
        import subprocess
        subprocess.run(["notify-send", "-u", "critical", "-a", "Settings",
                        "Settings app can't start",
                        "Missing GTK4/libadwaita bindings. "
                        "Run: sudo dnf install python3-gobject gtk4 libadwaita"],
                       check=False)
    except Exception:
        pass
    sys.exit(1)

if __name__ == "__main__":
    sys.exit(main())
