[Desktop Entry]
Name=Settings
GenericName=Desktop Settings
Comment=Theme, wallpaper, display, input, keys and system info for the Sway rice
Exec=__HOME__/.local/bin/rice-settings
Icon=preferences-system
Terminal=false
Type=Application
Categories=Settings;DesktopSettings;GTK;
Keywords=settings;preferences;theme;wallpaper;display;keyboard;sway;
StartupNotify=true
