# Ashfall — the one palette. Cold, desaturated, industrial: ash on charcoal.
#
# There is no light mode and no toggle. This file is the single definition;
# scripts/theme-gen.py derives every app's colors from it and REFUSES to
# generate anything that fails WCAG contrast — terminal text must clear 7:1
# and every text-bearing accent 3:1. Grim tends toward low contrast, so that
# gate is doing real work here, not ceremony.
#
# Edit a color, run ./scripts/theme-gen.py, then ./install.sh --configs-only.
NAME="Ashfall"
WALLPAPER=night
GTK_THEME=adw-gtk3-dark
ICON_THEME=Papirus-Dark
COLOR_SCHEME=prefer-dark

# --- surfaces: near-black with a faint cold cast, not pure #000 ------------
BG=0d0e11
BG_ALT=101217
BG_HL=1a1d24
BG_SEL=2c313b
BORDER=272c34

# --- text -----------------------------------------------------------------
FG=c8ccd2
FG_DIM=a2a9b3
MUTED=737b87

# --- accents: restrained, cold, one warm ember ----------------------------
ACCENT=8fa0b3
ACCENT2=a8899a
PINK=bd8298
RED=c96a60
ORANGE=c68a4e
YELLOW=b9a253
GREEN=87a173
TEAL=6fa39d
CYAN=7f9db3

# --- terminal ANSI --------------------------------------------------------
ANSI0=1a1d24
ANSI1=c96a60
ANSI2=87a173
ANSI3=b9a253
ANSI4=8fa0b3
ANSI5=bd8298
ANSI6=6fa39d
ANSI7=a2a9b3
ANSI8=4a515c
ANSI9=d88072
ANSI10=9bb587
ANSI11=ccb768
ANSI12=a3b4c7
ANSI13=cf97ad
ANSI14=84b8b2
ANSI15=e0e4ea
